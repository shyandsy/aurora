#!/usr/bin/env bash
# 分支命名守卫(shyandsy 各仓统一)—— 拒绝 push 不符规范的分支名。
#
# 允许前缀:**默认 feature/ | bugfix/ | docs/**。各仓可在同目录 `.githooks/branch-prefixes`
#   覆写(每行一个前缀名、不带斜杠;`#` 开头为注释、空行忽略)。例:某仓要放行 research/ 做 WIP,
#   就在该文件写 feature / bugfix / docs / research。维护/依赖/杂务无单独前缀,一律归 feature/。
#   main/master 例外(但约定:绝不强推 main,合并一律走 PR)。
#
# 这是**可靠**那层:push 时机械拦截,不依赖记忆。单一源在 aurora(scripts/git-hooks/pre-push);
#   各仓把它拷进自己的 .githooks/ 并 `git config core.hooksPath .githooks`(每个 clone 一次)即生效。
#   脚本改动去 aurora 改后重新分发;**允许前缀改 `.githooks/branch-prefixes`,别手改本脚本**。
#   建议再配一个 CI 分支名检查(读同一份 branch-prefixes),堵 --no-verify / 没跑 dev-setup 的漏。
set -euo pipefail

hook_dir="$(cd "$(dirname "$0")" && pwd)"
prefixes="feature bugfix docs"
cfg="$hook_dir/branch-prefixes"
if [ -f "$cfg" ]; then
  fromfile="$(grep -vE '^[[:space:]]*(#|$)' "$cfg" | tr '\n' ' ' || true)"
  fromfile="$(echo $fromfile)"   # 压掉多余空白
  [ -n "$fromfile" ] && prefixes="$fromfile"
fi
ALLOWED="^($(echo "$prefixes" | tr ' ' '|'))/"
PROTECTED='^(main|master)$'
fail=0

while read -r local_ref local_sha remote_ref remote_sha; do
  # 只管推往 refs/heads/* 的分支(忽略 tag 等)
  case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac
  # 跳过删除分支(local_sha 全 0)
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac
  branch="${remote_ref#refs/heads/}"
  [[ "$branch" =~ $PROTECTED ]] && continue
  if [[ ! "$branch" =~ $ALLOWED ]]; then
    echo "✗ 分支名 '$branch' 不符规范:必须以 $(echo "$prefixes" | sed 's/ / | /g') 之一(加 /)开头。" >&2
    echo "  改名重推:git branch -m '$branch' feature/<name> && git push -u origin feature/<name>" >&2
    fail=1
  fi
done

[ "$fail" -eq 0 ] || echo "✗ 已拦截本次 push(分支名规范见 aurora doc/conventions/branching.md)。" >&2
exit "$fail"
